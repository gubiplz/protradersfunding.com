{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/tick", "schedule": "0 3 * * *" },
    { "path": "/api/cron/streak-reminder", "schedule": "0 17 * * *" }
  ]
}
