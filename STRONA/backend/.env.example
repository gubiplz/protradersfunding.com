# === Tryb domyślny: 0 zł + REALNE konta demo MT5 (SQLite, Stripe MOCK, maile na konsolę) ===
# Konta zakładane na MetaQuotes-Demo przez web terminal — wymaga jednorazowo:
#   playwright install chromium
DATABASE_URL=sqlite:///./prop.db
FEED=metaquotes_web
METAQUOTES_WEB_ENABLED=true
POLL_INTERVAL_SEC=3

# Tryb czysto symulowany (bez MetaQuotes) — TYLKO do dem/testów UI.
# UWAGA: konta dostają wtedy serwer PropFunding-SIM, który nie istnieje w MT5.
# FEED=sim
# METAQUOTES_WEB_ENABLED=false
AUTO_SEED=true
SERVER_UTC_OFFSET_HOURS=2

# Marka strony publicznej (nazwa w nagłówkach, mailach, certyfikatach)
SITE_NAME=Pro Traders Funding
SUPPORT_EMAIL=support@protradersfunding.com

# Bezpieczeństwo / aplikacja
APP_BASE_URL=http://localhost:8000
SECRET_KEY=dev-secret-change-me        # podpis tokenów — ZMIEŃ na produkcji
ADMIN_TOKEN=admin                      # nagłówek X-Admin-Token w panelu admina

# === STRIPE (brak kluczy => checkout w trybie MOCK) ===
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...       # endpoint webhooka: POST /api/stripe/webhook
# CURRENCY=usd

# === E-MAIL (SMTP). Brak hosta => maile drukowane na konsoli ===
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=no-reply@twojapropfirma.com

# Webhook powiadomień (np. Make/Telegram) — opcjonalny
# NOTIFY_WEBHOOK_URL=

# === PRODUKCJA: Supabase Postgres ===
# Supabase -> Project Settings -> Database -> Connection string -> URI,
# potem podmien schemat "postgresql://" na "postgresql+psycopg://".
#
# Pooler (zalecany dla aplikacji, port 6543):
# DATABASE_URL=postgresql+psycopg://postgres.[REF]:[HASLO]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Direct (port 5432, np. do jednorazowych migracji):
# DATABASE_URL=postgresql+psycopg://postgres:[HASLO]@db.[REF].supabase.co:5432/postgres
#
# Na produkcji ZAWSZE:
#   AUTO_SEED=false     (bez kont demo i przykladowych traderow)
#   SECRET_KEY=...      (dlugi losowy ciag)
#   ADMIN_TOKEN=...     (nie zostawiaj 'admin')

# === REALNE MT5 przez MetaApi ===
# FEED=metaapi
# METAAPI_TOKEN=
# METAAPI_REGION=new-york
#
# MODEL DOMYŚLNY = PULA KONT (jak firmy fundingowe bez własnego serwera):
#   zasilasz pulę gotowymi kontami MT5 (panel admina -> "Pula kont MT5"); przy zakupie
#   system przydziela wolne konto, wysyła login/hasło i włącza monitoring DD + enforcement.
#   Equity/enforcement działa przez MetaApi (zamykanie pozycji + lock przy breachu).
#
# --- ŚCIEŻKA GŁÓWNA: automatyczne zakładanie REALNYCH kont demo MT5 ---
# Po włączeniu system po każdej płatności prosi brokera (przez REST MetaApi) o nowe
# konto demo i wysyła traderowi prawdziwy login/hasło/serwer. Pula (PoolAccount)
# zostaje wtedy mechanizmem awaryjnym.
# UWAGA: nie każdy broker pozwala na programowe zakładanie dem — sprawdź przed startem.
# METAAPI_AUTO_CREATE=true
# METAAPI_PROVISIONING_PROFILE_ID=      # z panelu MetaApi (profil MT5)
# METAAPI_ACCOUNT_TYPE=standard
#
# Wskazanie serwera demo — ALBO dokładna nazwa, ALBO nazwy brokera do wyszukania:
# METAAPI_DEMO_SERVER_NAME=ICMarketsSC-Demo
# METAAPI_DEMO_KEYWORDS=IC Markets,ICMarkets
#
# Parametry zakładanego konta i ochrona przed rate-limitem brokera:
# METAAPI_DEMO_LEVERAGE=100
# METAAPI_DEMO_PHONE=+10000000000       # broker wymaga telefonu; Trader go nie zbiera
# METAAPI_DEMO_MIN_INTERVAL_SEC=2       # minimalny odstęp między żądaniami do brokera
# METAAPI_DEMO_MAX_ATTEMPTS=5           # ponowienia (ten sam transaction-id = idempotencja)


# === KONTA DEMO MT5 Z WEB TERMINALA METAQUOTES (kanal darmowy) ===
# System steruje formularzem "Open Demo account" na web.metatrader.app i zaklada
# PRAWDZIWE konta na serwerze MetaQuotes-Demo, na dane klienta zebrane przy platnosci.
# METAQUOTES_WEB_ENABLED=true
# FEED=metaquotes_web                  # equity czytane z terminala (bez platnego MetaApi)
#
# METAQUOTES_WEB_ACCOUNT_TYPE=Forex Hedged USD
# METAQUOTES_WEB_LEVERAGE=100
# METAQUOTES_WEB_MIN_INTERVAL_SEC=20   # MetaQuotes limituje rejestracje po IP
# METAQUOTES_WEB_TIMEOUT_SEC=45
# METAQUOTES_WEB_SCREENSHOT_DIR=/tmp/mq-fails   # zrzuty przy bledzie (debug)
#
# RISK ENGINE — co ile odswiezac equity kazdego konta. To jest zarazem
# OPOZNIENIE wykrycia breachu: logowanie do terminala trwa ~20-25 s.
# METAQUOTES_WEB_POLL_SEC=120
# METAQUOTES_WEB_CONCURRENCY=2         # ile przegladarek naraz
